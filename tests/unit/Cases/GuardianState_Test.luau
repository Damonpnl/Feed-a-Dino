local Shared = game.ReplicatedStorage.Shared
local State = require(Shared.GuardianState)
local Config = require(Shared.GuardianConfig)
local Chase = require(Shared.GuardianChase)
return function(t)
	t.test("common pickup wakes immediately without a disturbance meter", function()
		local s = State.new(Config.Areas.Grasslands)
		t.expect.truthy(s:pickup("Common", 10))
		t.expect.equal(s.State, "WAKING")
		t.expect.equal(s.Disturbance, 0)
		t.expect.equal(s.Activation, 1)
		s:pickup("Common", 10)
		t.expect.equal(s.Activation, 1)
		s:step(10 + Chase.wake(s.Config))
		t.expect.equal(s.State, "PURSUING")
		s:step(10 + Chase.wake(s.Config) + Chase.attackDelay("Common"))
		t.expect.equal(s.State, "WARNING")
	end)
	for _, rarity in { "Secret", "Eternal", "Divine" } do
		t.test(rarity .. " pickup wakes immediately", function()
			local s = State.new(Config.Areas.Volcano)
			s:pickup(rarity, 10)
			t.expect.equal(s.State, "WAKING")
			t.expect.equal(s.Disturbance, 0)
			t.expect.equal(s.Activation, 1)
		end)
	end
	t.test("failed rarity does not wake and areas stay independent", function()
		local a, b = State.new(Config.Areas.Swamp), State.new(Config.Areas.Jungle)
		t.expect.falsy(b:pickup("Forged", 0))
		t.expect.equal(b.State, "SLEEPING")
		t.expect.truthy(a:pickup("Cosmic", 0))
		t.expect.equal(a.State, "WAKING")
		t.expect.equal(b.Disturbance, 0)
		t.expect.equal(a.Disturbance, 0)
	end)
	for area, c in Config.Areas do
		t.test(area .. " one legal timed cycle returns to sleep", function()
			local s = State.new(c)
			local order = {}
			local emit = function(state) table.insert(order, state) end
			s:pickup("Secret", 0, emit)
			s:step(1000, emit)
			t.expect.deepEqual(order, { "WAKING", "PURSUING", "WARNING", "HAZARD", "COOLDOWN", "RETURNING", "SLEEPING" })
			t.expect.equal(s.State, "SLEEPING")
			t.expect.equal(s.Disturbance, 0)
			t.expect.equal(s.Activation, 1)
		end)
	end
	t.test("late frame samples one hazard window and does not extend it", function()
		local c = Config.Areas.Grasslands
		local s = State.new(c)
		s:pickup("Secret", 10)
		local interval
		s:step(1000, nil, function(a, b) interval = { a, b } end)
		local startAt = 10 + Chase.wake(s.Config) + Chase.attackDelay("Secret") + c.Warning
		t.expect.near(interval[1], startAt, 1e-4)
		t.expect.near(interval[2] - interval[1], c.Active, 1e-4)
		t.expect.equal(s.State, "SLEEPING")
	end)
	t.test("reset cancels a pending attack", function()
		local s = State.new(Config.Areas.Grasslands)
		s:pickup("Secret", 0)
		s:reset()
		local hits = 0
		s:step(100, nil, function() hits += 1 end)
		t.expect.equal(hits, 0)
		t.expect.equal(s.State, "SLEEPING")
		t.expect.equal(s.Disturbance, 0)
	end)
	-- A contact may synchronously reconcile the field cutoff; never finish its stale cycle.
	t.test("reset during contact cancels remaining hazard transitions", function()
		local s = State.new(Config.Areas.Grasslands)
		s:pickup("Secret", 0)
		local samples, afterReset = 0, {}
		local reset = false
		s:step(1000, function(state)
			if reset then table.insert(afterReset, state) end
		end, function()
			samples += 1
			s:reset()
			reset = true
		end)
		t.expect.equal(samples, 1)
		t.expect.equal(s.State, "SLEEPING")
		t.expect.equal(s.Deadline, nil)
		t.expect.equal(#afterReset, 0)
	end)
	t.test("returning is not a fixed short timer; travel home ends it", function()
		local s = State.new(Config.Areas.Volcano)
		s:pickup("Divine", 0)
		s:step(Chase.wake(s.Config), nil, nil, { retreat = true })
		t.expect.equal(s.State, "RETURNING")
		s:step(Chase.wake(s.Config) + 10, nil, nil, {})
		t.expect.equal(s.State, "RETURNING")
		s:step(Chase.wake(s.Config) + 12, nil, nil, { home = true })
		t.expect.equal(s.State, "SLEEPING")
		t.expect.truthy(Chase.Timing.ReturnDuration >= 60)
	end)
	t.test("valid pursuit never times out inside the state engine", function()
		local s = State.new(Config.Areas.Grasslands)
		s:pickup("Common", 0)
		for time = 1, 400, 7 do s:step(time, nil, nil, { attack = false }) end
		t.expect.equal(s.State, "PURSUING")
	end)
	t.test("sleep cannot transition directly to hazard", function()
		local s = State.new(Config.Areas.Grasslands)
		t.expect.throws(function() s:transition("HAZARD", 0) end)
	end)
	t.test("pickup during an attack does not start a second encounter", function()
		local s = State.new(Config.Areas.Grasslands)
		s:pickup("Divine", 0)
		s:step(Chase.wake(s.Config) + Chase.attackDelay("Divine"))
		t.expect.equal(s.State, "WARNING")
		local activation = s.Activation
		t.expect.truthy(s:pickup("Common", s.Deadline))
		t.expect.equal(s.State, "WARNING")
		t.expect.equal(s.Activation, activation)
		t.expect.equal(s.Rarity, "Divine")
	end)
end
