local Shared = game.ReplicatedStorage.Shared
local Protocol = require(Shared.DevTestProtocol)
return function(t)
	t.test("studio authorization needs both gates and ignores a client user id", function()
		t.expect.falsy(Protocol.allowed(false, true, 1, {}))
		t.expect.falsy(Protocol.allowed(true, false, 1, {}))
		t.expect.truthy(Protocol.allowed(true, true, 7, {}))
		t.expect.falsy(Protocol.allowed(true, true, 7, { 3 }))
		t.expect.truthy(Protocol.allowed(true, true, 3, { 3 }))
		t.expect.falsy(Protocol.allowed(true, true, "3", { 3 }))
	end)
	t.test("unknown commands and unbounded rewards are rejected", function()
		local ok = Protocol.validate("GrantAnything", { Cash = 1e18 })
		t.expect.falsy(ok)
		ok = Protocol.validate("SetPower", { Value = math.huge })
		t.expect.falsy(ok)
		ok = Protocol.validate("SetPower", { Value = -5 })
		t.expect.falsy(ok)
		ok = Protocol.validate("SetSpeedOverride", { Speed = 999 })
		t.expect.falsy(ok)
		ok = Protocol.validate("GiveResource", { Area = "Grasslands", Resource = "InfernoCatalyst" })
		t.expect.falsy(ok)
	end)
	t.test("presets and destructive actions resolve only through the allowlist", function()
		local ok, args = Protocol.validate("SetPower", { Preset = "350K", Value = 1 })
		t.expect.truthy(ok)
		t.expect.equal(args.Value, 350000)
		ok = Protocol.validate("Scenario", { Id = "Fresh" })
		t.expect.falsy(ok)
		ok, args = Protocol.validate("Scenario", { Id = "Volcano", Confirm = true })
		t.expect.truthy(ok)
		t.expect.equal(args.Id, "Volcano")
		ok, args = Protocol.validate("TravelSubmit", { Result = "Escape", Catches = 0, Source = "Scripted", Speed = 16 })
		t.expect.truthy(ok)
		t.expect.equal(args.Source, "Human")
	end)
	t.test("launch resources and pet forms must exist", function()
		local ok = Protocol.validate("SpawnResource", { Area = "CrystalCave", Resource = "CrystalShard" })
		t.expect.truthy(ok)
		ok = Protocol.validate("CreatePet", { Id = "NotAPet" })
		t.expect.falsy(ok)
		ok = Protocol.validate("AddMutation", { Id = "Mutant" })
		t.expect.truthy(ok)
		ok = Protocol.validate("SetFamily", { Id = "Primal", Enabled = true })
		t.expect.truthy(ok)
	end)
end
